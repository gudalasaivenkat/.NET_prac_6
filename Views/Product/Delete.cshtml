@model ProductCatalog.Models.Product

@{
    ViewBag.Title = "Delete Product";
}

<h2>Delete Product</h2>

<h4>Are you sure you want to delete this product?</h4>

<p><strong>Name:</strong> @Model.Name</p>
<p><strong>Category:</strong> @Model.Category</p>
<p><strong>Price:</strong> ₹@Model.Price.ToString("N2")</p>

@using (Html.BeginForm("Delete", "Product",
    new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()

    <button type="submit" class="btn btn-danger">
        Confirm Delete
    </button>

    @Html.ActionLink("Cancel", "Index",
        null, new { @class = "btn btn-default" })
}
